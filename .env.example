# Manasitra AI Engine & Model Training Environment
# Copy this file to .env and configure local values

# Inference Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Hugging Face / Model Weights Access
HF_TOKEN=your_huggingface_token_here
BASE_MODEL_NAME=meta-llama/Llama-3.2-3B-Instruct

# Device Configuration (cuda, mps, or cpu)
DEVICE_MAP=auto
TORCH_DTYPE=float16

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://www.mansitra.in
